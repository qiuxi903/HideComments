# 复制成 keystore.properties 并填上你自己的信息，:app:assembleRelease 就会自动签名。
# 生成一个 keystore：
#   keytool -genkeypair -v -keystore hidecomments.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias hidecomments

storeFile=hidecomments.jks
storePassword=改成你的密码
keyAlias=hidecomments
keyPassword=改成你的密码
