<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      MIUI / HyperOS 风格。

      MIUI 视觉上的几个关键点，都在这里对齐了：
        - 主色是那支蓝（#3482FF），不是 Material3 默认的紫
        - 卡片纯白、零描边、零投影，靠留白而不是线条分区
        - 圆角很大（18dp），MIUI 一直是这个尺度
        - 背景是偏冷的浅灰（#F5F5F7），不是纯白
    -->
    <style name="Theme.HideComments" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/miui_blue</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">@color/miui_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/miui_blue_dark</item>

        <item name="colorSecondary">@color/miui_blue</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorSecondaryContainer">@color/miui_blue_light</item>
        <item name="colorOnSecondaryContainer">@color/miui_blue_dark</item>

        <item name="colorSurface">@color/miui_surface_light</item>
        <item name="colorOnSurface">@color/miui_on_surface_light</item>
        <item name="colorSurfaceVariant">#FFF0F0F2</item>
        <item name="colorOnSurfaceVariant">@color/miui_on_surface_variant_light</item>
        <item name="colorOutline">@color/miui_outline_light</item>
        <item name="colorOutlineVariant">@color/miui_outline_light</item>

        <item name="android:colorBackground">@color/miui_bg_light</item>
        <item name="colorSurfaceContainer">@color/miui_surface_light</item>
        <item name="colorSurfaceContainerLow">@color/miui_surface_light</item>
        <item name="colorSurfaceContainerLowest">@color/miui_surface_light</item>
        <item name="colorSurfaceContainerHigh">#FFF0F0F2</item>
        <item name="colorSurfaceContainerHighest">#FFEBEBED</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
